PORT=4173
CHROLLO_HOST=127.0.0.1
CHROLLO_DATA_DIR=./data
CHROLLO_SCAN_TIMEOUT_MS=90000
CHROLLO_MAX_FILES=2500
CHROLLO_MAX_FILE_BYTES=512000
CHROLLO_MAX_SCAN_BYTES=50000000
CHROLLO_MAX_CLONE_BYTES=500000000
CHROLLO_MAX_ARCHIVE_ENTRIES=20000
CHROLLO_MAX_FINDINGS=1000
# Vercel automatically uses archive mode. Local development defaults to git.
CHROLLO_REPOSITORY_MODE=git
CHROLLO_SCAN_CONCURRENCY=2
CHROLLO_MAX_QUEUED_SCANS=20
CHROLLO_RATE_LIMIT=120
CHROLLO_SCAN_RATE_LIMIT=6
CHROLLO_EXTERNAL_SCANNERS=false
CHROLLO_MAX_REPO_KB=250000
CHROLLO_GIT_DEPTH=50
CHROLLO_HISTORY_SCAN=true
CHROLLO_HISTORY_COMMITS=50
CHROLLO_LIVE_OSV=true
CHROLLO_RETENTION_DAYS=30
CHROLLO_ALLOWED_ORIGINS=

# Optional bearer token for API-only deployments. The bundled browser UI does not
# expose this token; on Vercel, prefer Deployment Protection or an identity proxy.
CHROLLO_API_TOKEN=

# Optional. Code evidence is sent to Google only when both values are set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# GitHub authentication. Prefer a GitHub App for teams. GITHUB_TOKEN is a
# development fallback and should be fine-grained to selected repositories.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
CHROLLO_PR_BRANCH_PREFIX=chrollo/fix

# Optional durable storage. Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
