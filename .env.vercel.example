# Required for durable scan history, exports, rescans and review decisions.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Recommended. A fine-grained token must be limited to repositories Chrollo may scan.
GITHUB_TOKEN=

# Optional integrations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Vercel-safe resource limits.
CHROLLO_SCAN_TIMEOUT_MS=240000
CHROLLO_MAX_REPO_KB=100000
CHROLLO_MAX_CLONE_BYTES=200000000
CHROLLO_MAX_ARCHIVE_ENTRIES=20000
CHROLLO_MAX_FILES=2500
CHROLLO_MAX_FILE_BYTES=512000
CHROLLO_MAX_SCAN_BYTES=50000000
CHROLLO_MAX_FINDINGS=500
CHROLLO_LIVE_OSV=true
CHROLLO_EXTERNAL_SCANNERS=false

# Add a separate frontend origin only when the API is hosted on another domain.
CHROLLO_ALLOWED_ORIGINS=
